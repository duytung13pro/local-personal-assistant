{
  "name": "local-personal-assistant",
  "productName": "Personal Assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local planner, calendar, checklist and AI workspace (Qwen + Codex + Claude).",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "start": "npm run build && electron .",
    "shot": "npm run build && electron . --screenshot",
    "icon": "electron scripts/make-icon.js",
    "shortcut": "npm run build && electron scripts/create-shortcut.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "katex": "^0.19.1",
    "lucide-react": "^1.75.0",
    "markdown-it": "^15.0.3",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
